    "timeout_sec": 10.0,
    "cache_ttl_hours": 24,
    "recommendation_model": "llama3.2:3b"
  },
  "language": {
    "response_language": "auto",
    "response_format": "native",
    "voice_output_language": "follow_response",
    "specific_voice_language": "en",
    "stt_language": "auto"
  }
