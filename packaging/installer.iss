; Script generated by Inno Setup Script Wizard.
; AI Desktop Friend — Windows Installer Specification
; Target: AI-Desktop-Friend-Setup.exe

#define MyAppName "AI Desktop Friend"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "Gaurav Patel"
#define MyAppURL "https://github.com/GauravPatel/AI-Desktop-Friend"
#define MyAppExeName "AI Desktop Friend.exe"

[Setup]
; Basic Application Info
AppId={{5F7A3E2B-9C1D-4E8A-B234-7D6C5A9F0E12}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Installation Directories
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

; Output Configuration
OutputDir=..\dist
OutputBaseFilename=AI-Desktop-Friend-Setup
SetupIconFile=..\assets\icons\app_icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; Platform & Architecture (64-bit Windows)
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Permissions: No administrative rights required for per-user install, or standard UAC elevation
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; Visual Branding
WizardSmallImageFile=..\assets\icons\app_icon.png
DisableWelcomePage=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "startupicon"; Description: "Start AI Desktop Friend on Windows login"; GroupDescription: "Startup Options:"; Flags: unchecked

[Files]
; Standalone application bundle produced by PyInstaller
Source: "..\dist\AI Desktop Friend\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; License and Documentation
Source: "..\README.md"; DestDir: "{app}"; Flags: isreadme; DestName: "README.txt"

; NOTE: User data (conversations.db, settings.json, logs) is stored in %APPDATA%\AI Desktop Friend
; and is preserved across all updates and reinstalls.

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"
Name: "{autoprograms}\Uninstall {#MyAppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\{#MyAppExeName}"
Name: "{userstartup}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: startupicon; IconFilename: "{app}\{#MyAppExeName}"

[Run]
; Option to launch companion pet immediately upon installation finish
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Clean up app install directory upon uninstall
Type: filesandordirs; Name: "{app}"
